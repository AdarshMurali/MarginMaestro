# =============================================================================
# MarginMaestro — environment variable template
# Copy to .env and fill in. NEVER commit the real .env.
# Deployed envs read secrets from one JSON secret, chosen by SECRETS_SOURCE:
#   aws -> AWS Secrets Manager `marginmaestro/<APP_ENV>`
#   gcp -> GCP Secret Manager `marginmaestro-<APP_ENV>` in GCP_PROJECT_ID
# Explicit env vars always win over the secret.
# =============================================================================

# ---- App ----
APP_ENV=local                 # local | dev | prod
# Unset = env only when APP_ENV=local, AWS Secrets Manager otherwise (MM-101).
# SECRETS_SOURCE=env           # env | aws | gcp
# GCP_PROJECT_ID=marginmaestro-demo   # required when SECRETS_SOURCE=gcp
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from a browser (the Next.js
# dev server's default port locally; add the deployed Vercel URL in MM-103).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- LLM (cost-controlled: local by default) ----
LLM_PROVIDER=openai           # openai | vertex (Gemini on Vertex AI, MM-109)
GEMINI_MODEL=gemini-3.8-flash # pinned version, used when LLM_PROVIDER=vertex
GEMINI_LOCATION=global        # Gemini 3.x is served from `global` only; us-central1 = gemini-2.5-flash
# GCP_PROJECT_ID=marginmaestro-demo  # required for vertex
GCP_LOCATION=us-central1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Only set if LLM_PROVIDER=openai -- keep usage minimal. python-dotenv doesn't
# strip inline "# comment" text when the value before it is empty, so this
# note lives on its own line rather than trailing the assignment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Vector store (RAG) ----
# The chroma container in docker-compose.yml (host-run scripts use localhost;
# the app container overrides CHROMA_HOST to the docker network address).
# Embeddings use OpenAI text-embedding-3-small (see ADR-0006) -- OPENAI_API_KEY
# above is required for the RAG pipeline, not just the optional LLM path.
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ---- Adapter selection (MM-102, src/adapters/factory.py) ----
# Defaults are the pre-GCP stack; GCP values arrive with their phases
# (pgvector G1, pubsub G4, whatsapp G6).
VECTOR_STORE=chroma          # chroma
EVENT_BUS=kafka              # kafka
CLIENT_NOTIFIER=slack        # slack

# ---- Observability (MM-92) ----
# Jaeger's OTLP HTTP receiver, started by docker-compose.yml. "/v1/traces"
# is appended in code, not here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=marginmaestro-api

# ---- Relational DB (Azure SQL) ----
# Local dev target: the sqlserver container in docker-compose.yml
# (mcr.microsoft.com/azure-sql-edge). Swapping to the real Azure SQL
# instance later is a config-only change -- see docs/DATA_SOURCES.md 1b.
# MM-104: mssql (default, AWS/Azure SQL) or postgres (GCP track). To run the
# app against the local Postgres container instead of SQL Server, set:
#   DB_DIALECT=postgres  DB_PORT=5432  DB_USER=marginmaestro  DB_PASSWORD=marginmaestro-local
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=marginmaestro
DB_USER=sa
# Local container SA password only -- not a real secret, never used
# outside this machine. Must meet Azure SQL Edge's complexity rule
# (8+ chars, 3 of: upper/lower/digit/special).
DB_PASSWORD=MarginMaestro!Dev1

# ---- Streaming (Kafka / Redpanda) ----
# localhost:19092 is Redpanda's external listener (for host-run tools/scripts).
# Containers on the docker-compose network should use redpanda:9092 instead
# (see docker-compose.yml, where the app service overrides this).
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_PRICES=market.prices
KAFKA_TOPIC_EVENTS=market.events
KAFKA_TOPIC_IMPACT=market.impact
KAFKA_TOPIC_CALLS=margin.calls
KAFKA_TOPIC_DEAD_LETTER=market.dead-letter

# ---- FRED (rates/yields/VIX/macro reference data) ----
# Free, get a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- RAG document corpus (S3) ----
# Bucket created by infra/s3.tf (marginmaestro-<env>-documents-<account-id>).
S3_DOCUMENTS_BUCKET=
# The AWS account id expected to own that bucket -- passed as S3's
# ExpectedBucketOwner so uploads fail loud instead of silently landing in a
# different account's bucket of the same name (bucket names are globally
# unique but reusable once deleted).
S3_DOCUMENTS_BUCKET_OWNER=

# ---- Market feed ----
MARKET_FEED_MODE=simulated     # simulated | live
# How often the live feed poller (streaming/live_feed_poller.py) publishes a
# tick per ticker onto market.prices -- API requests never call yfinance
# directly (MM-59); they read the latest_prices/price_history tables instead.
LIVE_FEED_POLL_INTERVAL_SECONDS=60
# Curated demo universe (30 real tickers) -- see docs/DATA_SOURCES.md 1a for the
# rationale behind each group (mega-caps, 2026-buzzing, S&P 500 proxy, sector
# rounding, Treasury ETFs as G-Sec substitute, crypto).
MARKET_UNIVERSE=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,HPE,JPM,WFC,SPCX,PLTR,AMD,MU,SMCI,NFLX,INTC,SPY,XOM,JNJ,BRK-B,V,DIS,IEF,TLT,SHY,BTC-USD,ETH-USD,SOL-USD,XRP-USD

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ---- Jira ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MM

# ---- SLA / escalation ----
MARGIN_CALL_SLA_MINUTES=60

# ---- ServiceNow (escalation incidents only -- see docs/adr/0007) ----
# Free Personal Developer Instance: https://developer.servicenow.com
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
