# =============================================================================
# MarginMaestro — environment variable template
# Copy to .env and fill in. NEVER commit the real .env.
# In production these are sourced from AWS Parameter Store (see ADR / ARCHITECTURE).
# =============================================================================

# ---- App ----
APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- LLM (cost-controlled: local by default) ----
LLM_PROVIDER=ollama           # ollama | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=               # only if LLM_PROVIDER=openai — keep usage minimal
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings (local, free) ----
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# ---- Vector store (RAG) ----
CHROMA_PERSIST_DIR=./chroma_db

# ---- Relational DB (Azure SQL) ----
DB_HOST=
DB_PORT=1433
DB_NAME=marginmaestro
DB_USER=
DB_PASSWORD=

# ---- Streaming (Kafka / Redpanda) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PRICES=market.prices
KAFKA_TOPIC_EVENTS=market.events
KAFKA_TOPIC_CALLS=margin.calls

# ---- Market feed ----
MARKET_FEED_MODE=simulated     # simulated | live
MARKET_UNIVERSE=AAPL,MSFT,BTC-USD,ETH-USD   # curated demo universe

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ---- Jira ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MM

# ---- SLA / escalation ----
MARGIN_CALL_SLA_MINUTES=60
