# =============================================================================
# MarginMaestro — environment variable template
# Copy to .env and fill in. NEVER commit the real .env.
# Deployed envs read secrets from one JSON secret, chosen by SECRETS_SOURCE:
#   aws -> AWS Secrets Manager `marginmaestro/<APP_ENV>`
#   gcp -> GCP Secret Manager `marginmaestro-<APP_ENV>` in GCP_PROJECT_ID
# Explicit env vars always win over the secret.
# =============================================================================

# ---- App ----
APP_ENV=local                 # local | dev | prod
# Unset = env only when APP_ENV=local, AWS Secrets Manager otherwise (MM-101).
# SECRETS_SOURCE=env           # env | aws | gcp
# GCP_PROJECT_ID=marginmaestro-demo   # required when SECRETS_SOURCE=gcp
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from a browser (the Next.js
# dev server's default port locally; add the deployed Vercel URL in MM-103).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# MM-128: Host headers the MCP servers accept over HTTP (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# MM-129: "Ask the margin desk". none = chat off; agent_runtime = the deployed ADK agent.
DESK_ASSISTANT=none
DESK_AGENT_RESOURCE= # projects/<p>/locations/<l>/reasoningEngines/<id>, printed by desk_assistant.deploy
# The agent's MCP endpoints (terraform output mcp_urls) and how it signs calls: google | none
DESK_MCP_MARKET_DATA_URL=
DESK_MCP_RAG_URL=
DESK_MCP_MARGIN_STATUS_URL=
DESK_MCP_AUTH=none

# ---- LLM (cost-controlled: local by default) ----
LLM_PROVIDER=openai           # openai | vertex (Gemini on Vertex AI, MM-109)
GUARDRAIL_PROVIDER=incode     # incode | modelarmor | none -- screens every LLM call (MM-113/114)
MODEL_ARMOR_TEMPLATE_ID=marginmaestro-llm-traffic
MODEL_ARMOR_LOCATION=us-central1
REDACTOR_PROVIDER=regex       # regex | sdp (Sensitive Data Protection) | none (MM-115)
LLM_DATA_CLASS_FILTER=none    # none | catalog -- confidential catalog values pseudonymized/blocked before prompts (MM-135)
LINEAGE_EXPORTER=none         # none | datalineage -- OpenLineage per margin call to the Data Lineage API (MM-136)
LINEAGE_LOCATION=us-central1
# DATA_CATALOG_PATH=docs/data_catalog.yaml  # default: found in the checkout; the image sets /app/docs/...
GEMINI_MODEL=gemini-2.5-flash # pinned version, used when LLM_PROVIDER=vertex (MM-117)
GEMINI_LOCATION=us-central1   # regional + steady; Gemini 3.x needs `global` (stalls seen)
GEMINI_THINKING_BUDGET=0      # 2.5: thinking tokens (0 = off); 3.x uses GEMINI_THINKING_LEVEL
# GCP_PROJECT_ID=marginmaestro-demo  # required for vertex
GCP_LOCATION=us-central1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Only set if LLM_PROVIDER=openai -- keep usage minimal. python-dotenv doesn't
# strip inline "# comment" text when the value before it is empty, so this
# note lives on its own line rather than trailing the assignment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Vector store (RAG) ----
# The chroma container in docker-compose.yml (host-run scripts use localhost;
# the app container overrides CHROMA_HOST to the docker network address).
# Embeddings use OpenAI text-embedding-3-small (see ADR-0006) -- OPENAI_API_KEY
# above is required for the RAG pipeline, not just the optional LLM path.
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ---- Adapter selection (MM-102, src/adapters/factory.py) ----
# Defaults are the pre-GCP stack; GCP values arrive with their phases
# (pgvector G1, pubsub G4, whatsapp G6).
VECTOR_STORE=chroma          # chroma | pgvector (needs DB_DIALECT=postgres, EMBEDDING_PROVIDER=vertex)
EMBEDDING_PROVIDER=openai    # openai | vertex (gemini-embedding-001, 768 dims, us-central1)
DOCUMENT_STORE=s3            # s3 | gcs -- where RAG source documents are read from (MM-111)
# GCS_DOCUMENTS_BUCKET=marginmaestro-demo-documents
EVENT_BUS=kafka              # kafka | pubsub (MM-119)
# PUBSUB_EMULATOR_HOST=localhost:8085  # local Pub/Sub emulator (docker compose pubsub)
# Pub/Sub consumers locally (MM-120/121): python -m streaming.pubsub_worker
# Deployed (G5): Google-signed OIDC token from this SA, for this audience.
# INTERNAL_CALLER_SERVICE_ACCOUNT=mm-invoker-sa@marginmaestro-demo.iam.gserviceaccount.com
# INTERNAL_CALLER_AUDIENCE=https://<cloud-run-url>
# Bearer token for the /internal/* endpoints when run locally (MM-120/121).
# INTERNAL_JOB_TOKEN=
CLIENT_NOTIFIER=slack        # slack | whatsapp (G6: client notices on WhatsApp, ADR-0016)
INTERNAL_NOTIFIER=none       # none | slack (G6: approval requests, acks, failures, escalations, daily summary)
SLA_SCHEDULER=none           # none | cloudtasks (MM-122; timer calls /internal/sla/{thread}/check)
# INTERNAL_BASE_URL=https://<cloud-run-url>   # where Cloud Tasks sends SLA checks (G5)

# ---- Observability (MM-92) ----
# Jaeger's OTLP HTTP receiver, started by docker-compose.yml. "/v1/traces"
# is appended in code, not here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=marginmaestro-api

# ---- Relational DB (Azure SQL) ----
# Local dev target: the sqlserver container in docker-compose.yml
# (mcr.microsoft.com/azure-sql-edge). Swapping to the real Azure SQL
# instance later is a config-only change -- see docs/DATA_SOURCES.md 1b.
# MM-104: mssql (default, AWS/Azure SQL) or postgres (GCP track). To run the
# app against the local Postgres container instead of SQL Server, set:
#   DB_DIALECT=postgres  DB_PORT=5432  DB_USER=marginmaestro  DB_PASSWORD=marginmaestro-local
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=marginmaestro
DB_USER=sa
# Local container SA password only -- not a real secret, never used
# outside this machine. Must meet Azure SQL Edge's complexity rule
# (8+ chars, 3 of: upper/lower/digit/special).
DB_PASSWORD=MarginMaestro!Dev1
# DB_AUTH=password           # password | iam (Cloud SQL IAM login, token as password; MM-123)

# ---- Streaming (Kafka / Redpanda) ----
# localhost:19092 is Redpanda's external listener (for host-run tools/scripts).
# Containers on the docker-compose network should use redpanda:9092 instead
# (see docker-compose.yml, where the app service overrides this).
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_PRICES=market.prices
KAFKA_TOPIC_EVENTS=market.events
KAFKA_TOPIC_IMPACT=market.impact
KAFKA_TOPIC_CALLS=margin.calls
KAFKA_TOPIC_DEAD_LETTER=market.dead-letter

# ---- FRED (rates/yields/VIX/macro reference data) ----
# Free, get a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- RAG document corpus (S3) ----
# Bucket created by infra/s3.tf (marginmaestro-<env>-documents-<account-id>).
S3_DOCUMENTS_BUCKET=
# The AWS account id expected to own that bucket -- passed as S3's
# ExpectedBucketOwner so uploads fail loud instead of silently landing in a
# different account's bucket of the same name (bucket names are globally
# unique but reusable once deleted).
S3_DOCUMENTS_BUCKET_OWNER=

# ---- Market feed ----
MARKET_FEED_MODE=simulated     # simulated | live
# How often the live feed poller (streaming/live_feed_poller.py) publishes a
# tick per ticker onto market.prices -- API requests never call yfinance
# directly (MM-59); they read the latest_prices/price_history tables instead.
LIVE_FEED_POLL_INTERVAL_SECONDS=60
# Curated demo universe (30 real tickers) -- see docs/DATA_SOURCES.md 1a for the
# rationale behind each group (mega-caps, 2026-buzzing, S&P 500 proxy, sector
# rounding, Treasury ETFs as G-Sec substitute, crypto).
MARKET_UNIVERSE=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,HPE,JPM,WFC,SPCX,PLTR,AMD,MU,SMCI,NFLX,INTC,SPY,XOM,JNJ,BRK-B,V,DIS,IEF,TLT,SHY,BTC-USD,ETH-USD,SOL-USD,XRP-USD

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ---- WhatsApp Cloud API (G6, ADR-0016) ----
# Used when CLIENT_NOTIFIER=whatsapp. The template has 4 body variables
# (reference, counterparty, amount, deadline) + an Acknowledge button; empty
# WHATSAPP_TEMPLATE_NAME = free-form text (24-hour window only).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=margin_call_notice
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v23.0
# Secrets (JSON secret keys when deployed; scripts\gcp_whatsapp_secrets.ps1):
WHATSAPP_TOKEN=
# The default recipient (digits with country code): used for counterparties
# without a contact. MM-143: per-counterparty contacts live in the
# counterparty_contacts table -- `python -m persistence.contacts set
# --counterparty CP-1 --name "..."` (the number is read from a hidden prompt).
# Meta's test number only delivers to verified recipients (at most 5).
WHATSAPP_RECIPIENT=
# MM-144: on = the personalised PDF notice as the DOCUMENT header of
# WHATSAPP_PDF_TEMPLATE_NAME (same 4 body variables + Acknowledge as v1).
# Keep off until Meta approves the v2 template.
WHATSAPP_NOTICE_PDF=off
WHATSAPP_PDF_TEMPLATE_NAME=margin_call_notice_v2
# Webhook (POST/GET /webhooks/whatsapp): Meta app secret for
# X-Hub-Signature-256, and the verify token typed into Meta's webhook form.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Label on every client-facing send of synthetic data ("" in production).
CLIENT_NOTICE_LABEL=(TEST)

# ---- Jira ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MM

# ---- SLA / escalation ----
MARGIN_CALL_SLA_MINUTES=60

# ---- ServiceNow (escalation incidents only -- see docs/adr/0007) ----
# Free Personal Developer Instance: https://developer.servicenow.com
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
