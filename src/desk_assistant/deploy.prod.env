# Non-secret deploy settings for the desk assistant (MM-129/130/131).
# Used as: ../.venv/Scripts/python.exe -m desk_assistant.deploy --env prod
GOOGLE_CLOUD_PROJECT=marginmaestro-demo
GCP_PROJECT_ID=marginmaestro-demo
GCP_LOCATION=us-central1
APP_ENV=prod
SECRETS_SOURCE=env
GUARDRAIL_PROVIDER=modelarmor
DESK_MCP_AUTH=google
# terraform -chdir=infra/gcp output mcp_urls
DESK_MCP_MARKET_DATA_URL=https://mcp-market-data-793928354019.us-central1.run.app/mcp
DESK_MCP_RAG_URL=https://mcp-rag-793928354019.us-central1.run.app/mcp
DESK_MCP_MARGIN_STATUS_URL=https://mcp-margin-status-793928354019.us-central1.run.app/mcp
