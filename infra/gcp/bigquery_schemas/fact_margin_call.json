{
  "description": "One row per margin call raised, with its lifecycle timestamps and outcome.",
  "kind": "fact",
  "partition_column": "raised_date",
  "partition_type": "DAY",
  "clustering": [
    "counterparty_id",
    "book"
  ],
  "require_partition_filter": false,
  "has_counterparty": true,
  "schema": [
    {
      "name": "raised_date",
      "type": "DATE",
      "mode": "REQUIRED",
      "description": "UTC date the call was raised (partition)"
    },
    {
      "name": "book",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "live | historical-sim"
    },
    {
      "name": "call_id",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "Call id (orchestrator thread id for live calls)"
    },
    {
      "name": "counterparty_id",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "Counterparty id (CP-n live, SIM-nnnn simulated)"
    },
    {
      "name": "trigger_type",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "daily_margin_run, price_shock, rating_downgrade, ..."
    },
    {
      "name": "call_amount",
      "type": "FLOAT",
      "mode": "REQUIRED",
      "description": "Call amount (the adjusted amount when adjusted)"
    },
    {
      "name": "currency",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "CSA currency"
    },
    {
      "name": "rationale",
      "type": "STRING",
      "mode": "NULLABLE",
      "description": "Why the call was raised, generated by code"
    },
    {
      "name": "raised_at",
      "type": "TIMESTAMP",
      "mode": "REQUIRED",
      "description": "When the call was raised"
    },
    {
      "name": "approval_decision",
      "type": "STRING",
      "mode": "NULLABLE",
      "description": "approved | adjusted | rejected | ..."
    },
    {
      "name": "approved_at",
      "type": "TIMESTAMP",
      "mode": "NULLABLE",
      "description": "First approval decision"
    },
    {
      "name": "approver",
      "type": "STRING",
      "mode": "NULLABLE",
      "description": "First approver's username"
    },
    {
      "name": "manager_approved_at",
      "type": "TIMESTAMP",
      "mode": "NULLABLE",
      "description": "Second signature (elite)"
    },
    {
      "name": "notified_at",
      "type": "TIMESTAMP",
      "mode": "NULLABLE",
      "description": "Client notice sent"
    },
    {
      "name": "channel",
      "type": "STRING",
      "mode": "NULLABLE",
      "description": "slack | whatsapp | simulated"
    },
    {
      "name": "acknowledged_at",
      "type": "TIMESTAMP",
      "mode": "NULLABLE",
      "description": "Client acknowledged within SLA"
    },
    {
      "name": "escalated_at",
      "type": "TIMESTAMP",
      "mode": "NULLABLE",
      "description": "Escalated to ServiceNow"
    },
    {
      "name": "sla_outcome",
      "type": "STRING",
      "mode": "NULLABLE",
      "description": "met | breached | null while open"
    },
    {
      "name": "status",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "Lifecycle status when loaded"
    }
  ]
}
