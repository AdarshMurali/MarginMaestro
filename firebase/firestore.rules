rules_version = '2';

// MM-146 (ADR-0021): real-time margin-call status for the frontend.
//
// Only the API writes (server-side, as mm-api-sa through IAM -- security rules
// never apply to it). Browsers sign in with a Firebase custom token minted by
// GET /realtime/token, whose claims carry the user's row-level-security scope:
//   firm_wide: true   approver, manager, auditor -- every counterparty
//   cps: [...]        a scoped analyst's own counterparty ids
// The same rule as Postgres's app_can_see(). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /margin_call_status/{callId} {
      allow read: if request.auth != null
        && (request.auth.token.get('firm_wide', false) == true
            || resource.data.counterparty_id in request.auth.token.get('cps', []));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
