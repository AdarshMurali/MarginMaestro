# Copy to .env.local and adjust if the API isn't on the default port.
# Not a secret -- inlined into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# MM-57: NextAuth's own session-cookie encryption key. Server-side only,
# never sent to the browser. Generate with `npx auth secret` or
# `openssl rand -base64 32`.
AUTH_SECRET=

# Required when self-hosting off Vercel -- NextAuth otherwise rejects the
# request's Host header. Fine for local dev / this project's deployment.
AUTH_TRUST_HOST=true

# MM-57: must match the backend's AUTH_BACKEND_SECRET exactly -- signs the
# short-lived JWT this app mints and FastAPI verifies on mutating endpoints.
AUTH_BACKEND_SECRET=
