# Copy to .env.local and adjust if the API isn't on the default port.
# Not a secret -- inlined into the browser bundle at build time. Local dev
# only: point this straight at the backend (matching schemes, no mixed
# content). On Vercel (MM-103), set this to `/api` instead and set
# BACKEND_API_URL (below) to the real backend -- see next.config.ts's
# rewrites() for why: an HTTPS page can't fetch a plain http:// backend
# directly, so the browser calls this same origin's /api/* and Vercel
# proxies it server-side, where that restriction doesn't apply.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Only used by next.config.ts's rewrites() (server-side, never shipped to
# the browser) to proxy /api/* to the real backend when
# NEXT_PUBLIC_API_BASE_URL=/api. Not needed for local dev.
BACKEND_API_URL=

# MM-57: NextAuth's own session-cookie encryption key. Server-side only,
# never sent to the browser. Generate with `npx auth secret` or
# `openssl rand -base64 32`.
AUTH_SECRET=

# Required when self-hosting off Vercel -- NextAuth otherwise rejects the
# request's Host header. Fine for local dev / this project's deployment.
AUTH_TRUST_HOST=true

# MM-57: must match the backend's AUTH_BACKEND_SECRET exactly -- signs the
# short-lived JWT this app mints and FastAPI verifies on mutating endpoints.
AUTH_BACKEND_SECRET=
